# MyNote iOS release lanes.
#
# Authentication is an App Store Connect API key, never an Apple ID password:
# it survives 2FA, can be scoped, and can be revoked without locking anyone out.

default_platform(:ios)

APP_IDENTIFIER = "io.mynote.app".freeze

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # The Xcode project is generated, not committed, so regenerate before build.
    sh("cd .. && xcodegen generate")

    # Build number must be unique per upload; TestFlight rejects a repeat.
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER) + 1,
      xcodeproj: "MyNote.xcodeproj"
    )

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: ENV["CI"] ? true : false
    )

    build_app(
      project: "MyNote.xcodeproj",
      scheme: "MyNote",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      # Export compliance is declared in Info.plist
      # (ITSAppUsesNonExemptEncryption = false), so this needs no prompt.
      distribute_external: false
    )
  end

  desc "Run the core package tests"
  lane :test do
    sh("cd ../MyNoteCore && swift test")
  end

  desc "Promote the latest TestFlight build to the App Store"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER).to_s,
      skip_binary_upload: true,
      skip_screenshots: true,
      # Review notes and What's New live in fastlane/metadata/, so the listing
      # is version-controlled rather than edited in a web form.
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
