# MyNote iOS release lanes.
#
# Signing is Xcode-managed (automatic), matching how MyPlaylist ships — there is
# no `match` certificate repo to maintain. Authentication is an App Store Connect
# API key rather than an Apple ID password: it survives 2FA, can be scoped, and
# can be revoked without locking anyone out.
#
# For a first build you can skip fastlane entirely and use Xcode:
#   Product -> Archive -> Distribute App -> TestFlight & App Store

default_platform(:ios)

APP_IDENTIFIER = "com.chrisphua.MyNote".freeze
TEAM_ID = "9ZM956H7Q9".freeze

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run the core package tests"
  lane :test do
    sh("cd ../MyNoteCore && swift test")
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # The Xcode project is generated, not committed, so regenerate before build.
    sh("cd .. && xcodegen generate")

    # Build number must be unique per upload; TestFlight rejects a repeat.
    # `latest_testflight_build_number` returns 0 when the app has never been
    # uploaded, which is exactly right for the first build.
    increment_build_number(
      build_number: latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      ) + 1,
      xcodeproj: "MyNote.xcodeproj"
    )

    build_app(
      project: "MyNote.xcodeproj",
      scheme: "MyNote",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      # Let Xcode create and refresh the certificate and profile, including the
      # iCloud container. Requires the Apple ID to be signed in locally, or the
      # API key to have App Manager rights in CI.
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      # Export compliance is declared in Info.plist
      # (ITSAppUsesNonExemptEncryption = false), so this needs no prompt.
      distribute_external: false
    )
  end

  desc "Promote the latest TestFlight build to the App Store"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER).to_s,
      skip_binary_upload: true,
      skip_screenshots: true,
      # Review notes and What's New live in fastlane/metadata/, so the listing
      # is version-controlled rather than edited in a web form.
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
