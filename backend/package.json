  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5.7.3",
    "vitest": "~3.0.5",
    "wrangler": "^3.107.3"
  }
}
